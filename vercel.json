{
 "framework": null,
 "buildCommand": "",
 "outputDirectory": "public",
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/",
   "destination": "/estudos",
   "permanent": false
  }
 ],
 "headers": [
  {
   "source": "/estudos(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    }
   ]
  }
 ]
}